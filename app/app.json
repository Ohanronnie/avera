{
  "expo": {
    "name": "Avera",
    "slug": "Avera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/transparent-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/transparent-icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "avera.app",
      "splash": {
        "image": "./assets/transparent-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/transparent-icon.png",
          "backgroundColor": "#0A0A0A"
        }
      },
       "infoPlist": {
        "UIDesignRequiresCompatibility": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "package": "avera.app",
      "splash": {
        "image": "./assets/transparent-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/transparent-icon.png",
          "backgroundColor": "#0A0A0A"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "avera",
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.249640936667-09tllcnhcd8mvvjdp8eeu64e40bibmlh"
        }
      ],
      "expo-secure-store",
      "expo-router",
      [
        "./plugins/withAndroidAbiFilters",
        {
          "abiFilters": [
            "arm64-v8a"
          ]
        }
      ]
    ]
  }
}
