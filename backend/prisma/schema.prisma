// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  username        String?   @unique
  firstName       String?
  lastName        String?
  phoneNumber     String?
  avatarUrl       String?
  coverPhotoUrl   String?
  bio             String?
  trustScore      Decimal   @default(0.0) @db.Decimal(5, 2)
  googleId        String?   @unique
  accountVerified Boolean   @default(false)
  password        String?
  refreshHashed   String?
  country         String?
  state           String?
  city            String?
  address         String?
  zipCode         String?
  // Seller / Buyer fields
  isActive        Boolean   @default(true) // can be suspended/disabled
  rating          Float     @default(0.0) // avg rating from reviews
  numReviews      Int       @default(0)
  location        String? // city/state/country
  lastSeen        DateTime? // last online
  deviceToken     String? // for push notifications

  // Relations
  products            Product[] // products being sold
  reviews             Review[]
  wishlist            Wishlist[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  sentMessages        Message[]      @relation("SentMessages")
  wallet              Wallet?
  buyerOrders         Order[]        @relation("BuyerOrders")
  sellerOrders        Order[]        @relation("SellerOrders")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Wallet {
  id            Int                 @id @default(autoincrement())
  userId        Int                 @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber String              @unique
  accountName   String
  bankName      String              @default("Avera Test Bank")
  balance       Decimal             @default(0) @db.Decimal(14, 2)
  lockedBalance Decimal             @default(0) @db.Decimal(14, 2)
  transactions  WalletTransaction[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model WalletTransaction {
  id           Int                   @id @default(autoincrement())
  walletId     Int
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(14, 2)
  description  String
  reference    String?               @unique
  counterparty String?
  simulated    Boolean               @default(true)
  createdAt    DateTime              @default(now())

  @@index([walletId, createdAt])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  imageUrl    String?
  iconName    String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  price       Decimal      @db.Decimal(10, 2)
  condition   String // e.g. "New", "Used - Like New", "Used - Good"
  quantity    Int          @default(1)
  currency    String       @default("USD") // ISO currency code
  // Relations
  sellerId    Int
  seller      User         @relation(fields: [sellerId], references: [id])
  categoryId  Int
  category    Category     @relation(fields: [categoryId], references: [id])
  tags        ProductTag[]

  location String?

  // Media
  images        ProductImage[]
  wishlist      Wishlist[]
  conversations Conversation[]
  orders        Order[]

  // Reviews
  reviews    Review[]
  rating     Float    @default(0.0) // avg rating for this product
  numReviews Int      @default(0)

  // Status
  status     ProductStatus @default(ACTIVE)
  isFeatured Boolean       @default(false)
  views      Int           @default(0)

  // Trust & moderation
  flagged      Boolean              @default(false)
  verification ProductVerification?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model ProductTag {
  id        Int     @id @default(autoincrement())
  name      String
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model SearchKeywordTrend {
  id        Int      @id @default(autoincrement())
  keyword   String
  day       DateTime @db.Date
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keyword, day])
  @@index([day])
}

model Conversation {
  id           Int                @id @default(autoincrement())
  buyerId      Int
  buyer        User               @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId     Int
  seller       User               @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages     Message[]
  orders       Order[]
  status       ConversationStatus @default(ACTIVE)
  offeredPrice Decimal?           @db.Decimal(10, 2)
  closedAt     DateTime?
  closedReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([productId])
  @@index([buyerId, sellerId, productId, status])
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

model Order {
  id              Int           @id @default(autoincrement())
  buyerId         Int
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId        Int
  seller          User          @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  conversationId  Int
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  source          OrderSource   @default(BUY_NOW)
  status          OrderStatus   @default(PENDING_TRANSFER)
  quantity        Int
  unitPrice       Decimal       @db.Decimal(14, 2)
  subtotal        Decimal       @db.Decimal(14, 2)
  escrowFee       Decimal       @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryCity    String
  deliveryState   String
  deliveryCountry String
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentReference String       @unique
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([productId])
  @@index([status])
}

enum OrderSource {
  BUY_NOW
  OFFER
}

enum OrderStatus {
  PENDING_TRANSFER
  PAID_IN_ESCROW
  SELLER_PREPARING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  imageUrl       String?
  offerAmount    Decimal?     @db.Decimal(10, 2)
  offerQuantity  Int?
  offerStatus    OfferStatus?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ProductVerification {
  id         Int      @id @default(autoincrement())
  productId  Int      @unique
  product    Product  @relation(fields: [productId], references: [id])
  verified   Boolean  @default(false)
  notes      String?
  reviewedBy Int? // admin/moderator id
  createdAt  DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      @default(5) // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId]) // one review per user per product
}

enum ProductStatus {
  ACTIVE
  SOLD
  PENDING
  HIDDEN
  DELETED
}
